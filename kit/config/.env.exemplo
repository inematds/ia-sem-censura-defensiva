# Só NOMES de variáveis. Cada uma aponta para um arquivo privado FORA do repositório (chmod 600),
# com um único valor dentro. Nunca coloque a chave aqui, no chat ou na linha de comando.
INEMA_CHAVE_MODELO_ARQ=/caminho/privado/chave-do-modelo
INEMA_TOKEN_LOCAL_ARQ=/caminho/privado/token-da-guarda-local
INEMA_CHAVE_RUNPOD_ARQ=/caminho/privado/chave-de-controle-runpod
